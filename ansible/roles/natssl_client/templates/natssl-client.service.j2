[Unit]
Description=NATSSL Client (Cert Store)
Documentation=https://github.com/iskyneon/natssl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ natssl_bin }} --mode=client --config={{ natssl_conf_file }}
Restart=on-failure
RestartSec=3s

# The client listens on :8443 for signed migration announcements. CAP_NET_RAW is
# kept as an ambient capability so the disaster-recovery promotion path
# (`ping` during the safety chain) works even under NoNewPrivileges=true.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true

# The Ansible common role creates data_dir before this service starts.

# NOTE: the client installs the Root CA into the OS trust store, so it must be
# able to write to the system anchor directories and run update-ca-* tools.
# ProtectSystem is therefore relaxed (full, not strict) and the trust-store
# paths are explicitly allowed.
ProtectSystem=full
ReadWritePaths={{ natssl_data_dir }} -/usr/local/share/ca-certificates -/etc/pki/ca-trust -/etc/ssl/certs {{ natssl_conf_dir }}
PrivateTmp=true
ProtectKernelModules=true
RestrictSUIDSGID=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
